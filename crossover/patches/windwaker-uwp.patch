+endif ()
+if (WIN32 AND NOT COS_UWP)
+    set(CMAKE_MSVC_MANIFEST_OPTION "")
+    set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} /MANIFEST:NO")
+endif ()
 
 if (WIN32)
     file(GLOB _WIN_SDK_DIRS "C:/Program Files (x86)/Windows Kits/10/Include/10.*")
