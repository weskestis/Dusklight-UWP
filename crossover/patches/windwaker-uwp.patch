diff --git a/native/cmake/executable.cmake b/native/cmake/executable.cmake
index 4bee7c4..cde0c6c 100644
--- a/native/cmake/executable.cmake
+++ b/native/cmake/executable.cmake
@@ -170,6 +170,16 @@ foreach (_m IN LISTS COS_MODULES)
     list(APPEND _exe_objects "$<TARGET_OBJECTS:${_m}>")
 endforeach ()
 
+if (COS_UWP)
+    # Keep every game object and its static initialization in the archive. The
+    # Windows Store wrapper links this with /WHOLEARCHIVE and provides WinMain.
+    add_library(cos_uwp_game STATIC ${_exe_dol} ${_exe_rel} ${_exe_audio})
+    target_link_libraries(cos_uwp_game PRIVATE cos_pc cos_sdk)
+    set_target_properties(cos_uwp_game PROPERTIES LINKER_LANGUAGE CXX
+        ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
+    return()
+endif ()
+
 add_executable(switchwaker EXCLUDE_FROM_ALL "${_exe_dir}/cos_exe_stub.c")
 add_dependencies(switchwaker ${COS_MODULES})
 target_link_options(switchwaker PRIVATE "@${_exe_rsp}")
diff --git a/native/include/unistd.h b/native/include/unistd.h
index 70bc7b5..50a9571 100644
--- a/native/include/unistd.h
+++ b/native/include/unistd.h
@@ -86,7 +86,9 @@ static inline int open(const char* path, int oflag, ...) {
         mode = va_arg(ap, int);
         va_end(ap);
     }
-    return _open(path, oflag, mode);
+    // POSIX file descriptors are byte streams. The Windows CRT otherwise
+    // interprets 0x1A as EOF and translates CR/LF inside disc and save data.
+    return _open(path, oflag | _O_BINARY, mode);
 }
 
