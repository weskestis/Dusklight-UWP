diff --git a/platforms/uwp/cmake/AssetDeploy.cmake b/platforms/uwp/cmake/AssetDeploy.cmake
new file mode 100644
index 0000000..19aba3e
--- /dev/null
+++ b/platforms/uwp/cmake/AssetDeploy.cmake
@@ -0,0 +1,18 @@
+function(uwp_pkg target source_dir destination)
+    file(GLOB_RECURSE _files CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${source_dir}/*")
+    foreach (_src IN LISTS _files)
+        file(RELATIVE_PATH _relative "${source_dir}" "${_src}")
+        get_filename_component(_relative_dir "${_relative}" DIRECTORY)
+        if (_relative_dir STREQUAL "" OR _relative_dir STREQUAL ".")
+            set(_deploy_dir "${destination}")
+        else ()
+            string(REPLACE "\\" "/" _relative_dir "${_relative_dir}")
+            set(_deploy_dir "${destination}/${_relative_dir}")
+        endif ()
+        set_source_files_properties("${_src}" PROPERTIES
+                VS_COPY_TO_OUT_DIR Always
+                VS_DEPLOYMENT_CONTENT TRUE
+                VS_DEPLOYMENT_LOCATION "${_deploy_dir}")
+        target_sources(${target} PRIVATE "${_src}")
+    endforeach ()
+endfunction()
diff --git a/platforms/uwp/cmake/UwpSymbolManifest.props.in b/platforms/uwp/cmake/UwpSymbolManifest.props.in
new file mode 100644
index 0000000..40bef4e
--- /dev/null
+++ b/platforms/uwp/cmake/UwpSymbolManifest.props.in
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <Target Name="EmbedFinalUwpSymbolManifest" AfterTargets="Link">
+    <PropertyGroup>
+      <TprSymbolPdb Condition="'$(TargetPdbPath)' != ''">$(TargetPdbPath)</TprSymbolPdb>
+      <TprSymbolPdb Condition="'$(TprSymbolPdb)' == ''">$(TargetDir)$(TargetName).pdb</TprSymbolPdb>
+    </PropertyGroup>
+    <Error Condition="!Exists('$(TargetPath)')" Text="Final UWP executable is missing: $(TargetPath)" />
+    <Error Condition="!Exists('$(TprSymbolPdb)')" Text="Final UWP PDB is missing: $(TprSymbolPdb)" />
+    <Message Text="Embedding final UWP symbol manifest before packaging" Importance="high" />
+    <Exec
+      Command="&quot;@_symgen@&quot; manifest --pdb &quot;$(TprSymbolPdb)&quot; --embed &quot;$(TargetPath)&quot;"
+      WorkingDirectory="@DUSK_SOURCE_DIR@" />
+  </Target>
+</Project>
