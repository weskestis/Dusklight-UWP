diff --git a/platforms/uwp/CMakeLists.txt b/platforms/uwp/CMakeLists.txt
new file mode 100644
index 0000000..782cd13
--- /dev/null
+++ b/platforms/uwp/CMakeLists.txt
@@ -0,0 +1,159 @@
+cmake_minimum_required(VERSION 3.25)
+
+set(CMAKE_SYSTEM_NAME WindowsStore)
+set(CMAKE_SYSTEM_VERSION 10.0)
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL" CACHE STRING "" FORCE)
+
+project(Dusklight2UWP LANGUAGES CXX)
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
+include(AssetDeploy)
+
+set(DUSK_DIR "" CACHE PATH "Dusklight UWP feed build directory")
+set(DUSK_SOURCE_DIR "" CACHE PATH "Patched Dusklight source directory")
+set(UWP_DEP_SOURCE_DIR "" CACHE PATH "Pinned SternXD/uwp-dep checkout")
+
+foreach (_required_dir DUSK_DIR DUSK_SOURCE_DIR UWP_DEP_SOURCE_DIR)
+    if ("${${_required_dir}}" STREQUAL "" OR NOT IS_DIRECTORY "${${_required_dir}}")
+        message(FATAL_ERROR "${_required_dir} must name an existing directory")
+    endif ()
+endforeach ()
+
+set(_feed_archive "${DUSK_DIR}/dusklight.lib")
+set(_feed_def "${DUSK_DIR}/dusklight_exports.def")
+set(_bundled_mod_names
+    luau_runtime
+    cosmetics
+    randomizer)
+set(_bundled_mod_files)
+foreach (_mod IN LISTS _bundled_mod_names)
+    list(APPEND _bundled_mod_files "${DUSK_DIR}/bundled_mods/${_mod}.dusk")
+endforeach ()
+foreach (_required_file "${_feed_archive}" "${_feed_def}" ${_bundled_mod_files})
+    if (NOT EXISTS "${_required_file}")
+        message(FATAL_ERROR "Required UWP feed output is missing: ${_required_file}")
+    endif ()
+endforeach ()
+
+set(_uwp_x64 "${UWP_DEP_SOURCE_DIR}/x64")
+foreach (_required_file
+        "${_uwp_x64}/lib/SDL3.lib"
+        "${_uwp_x64}/lib/webgpu_dawn.lib"
+        "${_uwp_x64}/lib/nod.lib"
+        "${_uwp_x64}/lib/libuwp.lib")
+    if (NOT EXISTS "${_required_file}")
+        message(FATAL_ERROR "Pinned UWP dependency output is missing: ${_required_file}")
+    endif ()
+endforeach ()
+
+add_executable(${PROJECT_NAME} WIN32 main.cpp)
+set_directory_properties(PROPERTIES VS_STARTUP_PROJECT ${PROJECT_NAME})
+target_include_directories(${PROJECT_NAME} PRIVATE "${_uwp_x64}/include")
+target_compile_definitions(${PROJECT_NAME} PRIVATE AURORA_WINDOWS_STORE=1 _UWP=1)
+
+set(_runtime_dll_names
+    dxcompiler.dll
+    dxil.dll
+    libuwp.dll
+    nod.dll
+    SDL3.dll
+    webgpu_dawn.dll
+    libpng16.dll
+    z.dll)
+set(_runtime_files Package.appxmanifest)
+foreach (_dll IN LISTS _runtime_dll_names)
+    if (NOT EXISTS "${_uwp_x64}/bin/${_dll}")
+        message(FATAL_ERROR "Pinned UWP runtime DLL is missing: ${_uwp_x64}/bin/${_dll}")
+    endif ()
+    list(APPEND _runtime_files "${_uwp_x64}/bin/${_dll}")
+endforeach ()
+set_source_files_properties(${_runtime_files} PROPERTIES
+        VS_COPY_TO_OUT_DIR Always
+        VS_DEPLOYMENT_CONTENT TRUE
+        VS_DEPLOYMENT_LOCATION ".")
+target_sources(${PROJECT_NAME} PRIVATE ${_runtime_files})
+
+set(_asset_files
+    Assets/LockScreenLogo.scale-200.png
+    Assets/SplashScreen.scale-200.png
+    Assets/Square150x150Logo.scale-200.png
+    Assets/Square310x310Logo.scale-200.png
+    Assets/Square44x44Logo.scale-200.png
+    Assets/Square44x44Logo.targetsize-24_altform-unplated.png
+    Assets/StoreLogo.png
+    Assets/Wide310x150Logo.scale-200.png)
+foreach (_asset IN LISTS _asset_files)
+    if (NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${_asset}")
+        message(FATAL_ERROR "UWP package artwork is missing: ${_asset}")
+    endif ()
+endforeach ()
+set_source_files_properties(${_asset_files} PROPERTIES
+        VS_DEPLOYMENT_CONTENT TRUE
+        VS_DEPLOYMENT_LOCATION "Assets")
+target_sources(${PROJECT_NAME} PRIVATE ${_asset_files})
+
+# Bundle only the three mods that the exact upstream Dusklight 2.0 tree marks
+# BUNDLE: Luau Runtime, Cosmetics, and Randomizer. The loader extracts native
+# libraries to LocalState before LoadLibraryExW is called.
+set_source_files_properties(${_bundled_mod_files} PROPERTIES
+        VS_COPY_TO_OUT_DIR Always
+        VS_DEPLOYMENT_CONTENT TRUE
+        VS_DEPLOYMENT_LOCATION "mods")
+target_sources(${PROJECT_NAME} PRIVATE ${_bundled_mod_files})
+
+uwp_pkg(${PROJECT_NAME} "${DUSK_SOURCE_DIR}/res" "res")
+
+# The feed is single-config Ninja output. Link every static archive produced by
+# the requested core/module targets so new Borealis/Aurora leaf libraries do not
+# silently disappear when their dependency graph evolves.
+file(GLOB_RECURSE _feed_libraries LIST_DIRECTORIES FALSE "${DUSK_DIR}/*.lib")
+list(FILTER _feed_libraries EXCLUDE REGEX "[/\\\\]CMakeFiles[/\\\\]")
+list(FILTER _feed_libraries EXCLUDE REGEX "[/\\\\](tests?|examples?)[/\\\\]")
+list(FILTER _feed_libraries EXCLUDE REGEX "dusklight_imports[.]lib$")
+list(FILTER _feed_libraries EXCLUDE REGEX "[/\\\\]mods[/\\\\].*[.]lib$")
+list(REMOVE_ITEM _feed_libraries "${_feed_archive}")
+list(REMOVE_DUPLICATES _feed_libraries)
+
+set(_uwp_import_libraries
+    "${_uwp_x64}/lib/libuwp.lib"
+    "${_uwp_x64}/lib/nod.lib"
+    "${_uwp_x64}/lib/SDL3.lib"
+    "${_uwp_x64}/lib/webgpu_dawn.lib"
+    "${_uwp_x64}/lib/libpng16.lib"
+    "${_uwp_x64}/lib/z.lib")
+
+target_link_libraries(${PROJECT_NAME} PRIVATE
+    "${_feed_archive}"
+    ${_feed_libraries}
+    ${_uwp_import_libraries}
+    WindowsApp.lib
+    OneCore.lib
+    ntdll.lib
+    DXGI.lib
+    Ws2_32.lib)
+
+target_link_options(${PROJECT_NAME} PRIVATE
+    "/DEF:${_feed_def}"
+    "/WHOLEARCHIVE:${_feed_archive}"
+    /FUNCTIONPADMIN
+    /OPT:NOICF
+    /INCREMENTAL:NO
+    /NODEFAULTLIB:libcmt
+    /NODEFAULTLIB:libcmtd)
+
+# Embed the final executable's own PDB-derived symbol database. Runtime
+# by-name hooks reject a manifest generated from an intermediate archive.
+file(GLOB _symgen_candidates LIST_DIRECTORIES FALSE
+    "${DUSK_DIR}/_deps/symgen/symgen-windows-*.exe")
+list(LENGTH _symgen_candidates _symgen_count)
+if (NOT _symgen_count EQUAL 1)
+    message(FATAL_ERROR "Expected exactly one pinned symgen executable under ${DUSK_DIR}/_deps/symgen")
+endif ()
+list(GET _symgen_candidates 0 _symgen)
+configure_file(
+    "${CMAKE_CURRENT_SOURCE_DIR}/cmake/UwpSymbolManifest.props.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/UwpSymbolManifest.props"
+    @ONLY)
+set_property(TARGET ${PROJECT_NAME} PROPERTY VS_USER_PROPS
+    "${CMAKE_CURRENT_BINARY_DIR}/UwpSymbolManifest.props")
