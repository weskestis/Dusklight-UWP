diff --git a/cmake/PatchFunchook.cmake b/cmake/PatchFunchook.cmake
index cbd91fc..89d6bf9 100644
--- a/cmake/PatchFunchook.cmake
+++ b/cmake/PatchFunchook.cmake
@@ -11,6 +11,41 @@ if (NOT _content MATCHES "CAPSTONE_FIX_SCRIPT")
     file(WRITE "${SOURCE_DIR}/cmake/capstone.cmake.in" "${_content}")
 endif ()
 
+# The UWP build still needs Funchook for the official native mods, but the
+# upstream Windows backend always imports PSAPI.DLL for optional debug-only
+# module-name logging. PSAPI is a desktop dependency and prevents the Xbox
+# AppContainer process from loading. Keep the diagnostic on desktop builds and
+# compile it out of the UWP feed.
+file(READ "${SOURCE_DIR}/CMakeLists.txt" _content)
+if (NOT _content MATCHES "DUSK_UWP AND FUNCHOOK_DEPS")
+    string(REPLACE
+        "  set(FUNCHOOK_DEPS psapi)"
+        "  if (DUSK_UWP)\n    set(FUNCHOOK_DEPS) # UWP: PSAPI is desktop-only\n  else ()\n    set(FUNCHOOK_DEPS psapi)\n  endif () # DUSK_UWP AND FUNCHOOK_DEPS"
+        _content "${_content}")
+    file(WRITE "${SOURCE_DIR}/CMakeLists.txt" "${_content}")
+endif ()
+
+file(READ "${SOURCE_DIR}/src/funchook_windows.c" _content)
+if (NOT _content MATCHES "DUSK UWP: omit desktop-only PSAPI diagnostics")
+    string(REPLACE
+        "#define PSAPI_VERSION 1\n#include <stdint.h>"
+        "/* DUSK UWP: omit desktop-only PSAPI diagnostics. */\n#ifndef _UWP\n#define PSAPI_VERSION 1\n#endif\n#include <stdint.h>"
+        _content "${_content}")
+    string(REPLACE
+        "#include <psapi.h>"
+        "#ifndef _UWP\n#include <psapi.h>\n#endif"
+        _content "${_content}")
+    string(REPLACE
+        "    if (*funchook_debug_file != '\\0') {\n        DWORD len = GetMappedFileNameA(GetCurrentProcess(), func, path, sizeof(path));\n        if (len > 0) {\n            funchook_log(funchook, \"  func %p is in %.*s\\n\", func, (int)len, path);\n        }\n    }"
+        "#ifndef _UWP\n    if (*funchook_debug_file != '\\0') {\n        DWORD len = GetMappedFileNameA(GetCurrentProcess(), func, path, sizeof(path));\n        if (len > 0) {\n            funchook_log(funchook, \"  func %p is in %.*s\\n\", func, (int)len, path);\n        }\n    }\n#endif"
+        _content "${_content}")
+    string(REPLACE
+        "                if (*funchook_debug_file != '\\0') {\n                    DWORD len = GetMappedFileNameA(GetCurrentProcess(), func, path, sizeof(path));\n                    if (len > 0) {\n                        funchook_log(funchook, \"  -> func %p in %.*s\\n\", func, (int)len, path);\n                    } else {\n                        funchook_log(funchook, \"  -> func %p\\n\", func);\n                    }\n                }"
+        "#ifndef _UWP\n                if (*funchook_debug_file != '\\0') {\n                    DWORD len = GetMappedFileNameA(GetCurrentProcess(), func, path, sizeof(path));\n                    if (len > 0) {\n                        funchook_log(funchook, \"  -> func %p in %.*s\\n\", func, (int)len, path);\n                    } else {\n                        funchook_log(funchook, \"  -> func %p\\n\", func);\n                    }\n                }\n#endif"
+        _content "${_content}")
+    file(WRITE "${SOURCE_DIR}/src/funchook_windows.c" "${_content}")
+endif ()
+
 file(READ "${SOURCE_DIR}/src/funchook.c" _content)
 if (NOT _content MATCHES "commit_code_patch")
     string(REPLACE "#include \"funchook_internal.h\""
